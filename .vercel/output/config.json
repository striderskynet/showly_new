{
	"version": 3,
	"routes": [
		{
			"src": ".*",
			"continue": true,
			"transforms": [
				{
					"type": "request.query",
					"op": "delete",
					"target": {
						"key": "__pathname"
					}
				}
			]
		},
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "/_app/immutable/.+",
			"status": 404,
			"headers": {
				"cache-control": "no-store"
			},
			"continue": false
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/calendar/?(?:/__data.json)?$",
			"dest": "/calendar"
		},
		{
			"src": "^/hot/?(?:/__data.json)?$",
			"dest": "/hot"
		},
		{
			"src": "^/login/?(?:/__data.json)?$",
			"dest": "/login"
		},
		{
			"src": "^/logout/?(?:/__data.json)?$",
			"dest": "/logout"
		},
		{
			"src": "^/movies/?(?:/__data.json)?$",
			"dest": "/movies"
		},
		{
			"src": "^/search(/[^]*)?/?(?:/__data.json)?$",
			"dest": "/search/[...slug]"
		},
		{
			"src": "^/shows/?(?:/__data.json)?$",
			"dest": "/shows"
		},
		{
			"src": "^/show/add/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/show/add/[id]"
		},
		{
			"src": "^/show/([^/]+?)/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/show/[id]/[name]"
		},
		{
			"src": "^/sunbiz/?(?:/__data.json)?$",
			"dest": "/(test)/sunbiz"
		},
		{
			"src": "^/sunbiz/api/?(?:/__data.json)?$",
			"dest": "/(test)/sunbiz/api"
		},
		{
			"src": "^/trending/?(?:/__data.json)?$",
			"dest": "/trending"
		},
		{
			"src": "^/truper/?(?:/__data.json)?$",
			"dest": "/truper"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}